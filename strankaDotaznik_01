* {
    margin: 0;
    padding: 0;
}

body {
    background: linear-gradient(135deg, rgb(0, 110, 255), rgb(5, 17, 192));
    background-repeat: no-repeat;
    height: 100vh;
    display: flex;
    flex-direction: column;
}

header{
        background: rgb(1, 112, 216);
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        h1{
            color: white;
            padding: 10px; 
            display: inline;
            justify-self: center;
        }
        #odkazDomov{
            padding: 25px;
        }
    }

main{
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    gap: 70px;
    flex-grow: 1;
    #dotaznik_tlac{
        border-radius: 5px;
        padding: 5px;
        border: 0;
        color: rgb(15, 91, 255);
        background: white;
        font-size: 20px;
        width: 200px;
        height: 50px;
        transition: 250ms;
        &:hover{
            background-color: rgb(201, 200, 200);
            color: black;
        }
    }
    .hlavny_text{
        color: white;
        font-size: 70px;
        text-align: center;
    }
        
}

#dalsie_tlac{
    border-radius: 5px;
    padding: 5px;
    border: 0;
    color: rgb(15, 91, 255);
    background: white;
    font-size: 25px;
    width: 40px;
    height: 40px;
    &:hover{
        color: black;
        background-color: rgb(201, 200, 200);
    }
}

#stvrta_cast{
    width: 250px;
    gap: 15px;
}

.triedaTlacidla{
    display: grid;
    grid-template-columns: 500px 100px;
    .triedaTlacidla2{
        display: flex;
        flex-direction: column;
        width: 200px;
        gap: 20px;
    }
}



.tlacidla{
    padding: 10px;
    border-radius: 6px;
    color: rgb(15, 91, 255);
    font-weight: 700;
    background: white;
    border: 0;
    transition: 250ms;
    &:hover{
        border-radius: 20px;
        color: black;
        background-color: rgb(201, 200, 200);
    }
}

.tlacidla2{
    padding: 10px;
    border-radius: 20px;
    color: black;
    font-weight: 700;
    background: rgb(201, 200, 200);
    border: 0;
}


footer{
    margin-top: auto;
    padding: 10px;
    background: rgb(1, 112, 216);
}
